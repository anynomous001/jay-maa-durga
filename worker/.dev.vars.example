# Copy to .dev.vars (git-ignored) for `npm run dev`.
# Without Razorpay keys, ALLOW_MOCK=true lets you test the whole booking flow with fake payments.
ALLOW_MOCK=true
ADMIN_TOKEN=change-me-to-a-long-random-string
# Razorpay TEST keys (Dashboard → Settings → API Keys, in Test Mode):
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# Dodo Payments (optional, test mode unless DODO_ENVIRONMENT=live_mode). See README.
# DODO_PAYMENTS_API_KEY=dodo_test_xxxxxxxx
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_xxxxxxxx
# DODO_PRODUCT_ID=pdt_xxxxxxxx
# DODO_ENVIRONMENT=test_mode
